{
  "name": "pi-cascade",
  "version": "0.1.3",
  "description": "Independent configurable one- or two-model, evidence-centered coding agent powered by the Pi runtime",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pi-cascade": "./bin/pi-cascade.mjs"
  },
  "keywords": [
    "pi-package",
    "coding-agent",
    "multi-model",
    "routing",
    "openrouter",
    "muse-spark"
  ],
  "files": [
    "bin",
    "extension",
    "policies",
    "docs",
    "examples",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts",
    "UPSTREAM.json",
    "CHANGELOG.md",
    "TEST_REPORT.md",
    "licenses",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extension/index.mjs"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "node .bootstrap/materialize.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "pack:local": "npm pack --ignore-scripts",
    "release:local": "node scripts/release-local.mjs",
    "legal:check": "node scripts/check-legal.mjs",
    "ci": "npm test && npm run check && npm run legal:check && npm run smoke"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  },
  "author": "TanushV and contributors",
  "homepage": "https://github.com/TanushV/cascade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanushV/cascade.git"
  },
  "bugs": {
    "url": "https://github.com/TanushV/cascade/issues"
  },
  "packageManager": "npm@10.9.2"
}
