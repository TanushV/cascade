{
  "schemaVersion": 1,
  "mode": "dual",
  "worker": {
    "selectionMode": "native",
    "thinkingMode": "native",
    "provider": "openrouter",
    "model": "current-pi-model",
    "thinking": "medium",
    "restrictTools": false,
    "tools": ["read", "grep", "find", "ls", "bash", "edit", "write"],
    "instructions": ""
  },
  "expert": {
    "selectionMode": "configured",
    "thinkingMode": "configured",
    "provider": "openrouter",
    "model": "vendor/strong-model-id",
    "thinking": "high",
    "restrictTools": true,
    "tools": ["read", "grep", "find", "ls", "bash"],
    "timeoutMs": 600000,
    "maxOutputCharacters": 120000,
    "instructions": ""
  },
  "privacy": {
    "classification": "unknown",
    "allowContributor": false
  },
  "routing": {
    "autoConsult": true
  },
  "harnessLearning": {
    "mode": "observe",
    "scope": "repository"
  },
  "workspaceRuntime": {
    "enabled": false
  }
}
